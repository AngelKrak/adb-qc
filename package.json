{
  "name": "adb-qc",
  "version": "1.3.0",
  "description": "Quickly set up a wireless ADB connection for Android devices. Supports connection via pairing code or QR code, enabling remote debugging over Wi-Fi.",
  "main": "src/index.js",
  "preferGlobal": true,
  "scripts": {
    "test": "node --test",
    "start": "node src/index.js",
    "lint": "eslint ."
  },
  "author": {
    "name": "Angel Ramirez",
    "url": "https://github.com/AngelKrak"
  },
  "license": "MIT",
  "bin": {
    "adb-qc": "cli.js"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "node-dns-sd": "^1.0.2",
    "uqr": "^0.1.3"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/AngelKrak/adb-qc/issues"
  },
  "homepage": "https://github.com/AngelKrak/adb-qc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngelKrak/adb-qc.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "adb",
    "android",
    "connect",
    "devices",
    "wireless",
    "wifi",
    "adb-over-wifi",
    "usb-debugging",
    "mDNS",
    "android-devices",
    "pairing",
    "qr-code",
    "pairing-code",
    "tcp",
    "remote-debugging",
    "debugging",
    "device-discovery",
    "adb-connection",
    "adb-pairing",
    "adb-wlan",
    "wireless debugging",
    "adb wireless",
    "adb-wireless"
  ],
  "files": [
    "cli.js",
    "src",
    "README.es.md"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
